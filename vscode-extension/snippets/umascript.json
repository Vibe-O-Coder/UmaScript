{
  "Funcao tipada": {
    "prefix": "func",
    "body": [
      "${1:speed} ${2:nome}(${3:speed valor}) {",
      "    special ${4:valor};",
      "}"
    ],
    "description": "Funcao com retorno estaticamente verificado"
  },
  "Classe": {
    "prefix": "rudolf",
    "body": [
      "rudolf ${1:Corredora} {",
      "    groove speed ${2:velocidade};",
      "",
      "    opera(speed valor) {",
      "        teio.${2:velocidade} = valor;",
      "    }",
      "",
      "    condor speed ritmo() {",
      "        special teio.${2:velocidade};",
      "    }",
      "}"
    ],
    "description": "Classe com campo privado e construtor"
  },
  "Laco contado": {
    "prefix": "kitasan",
    "body": [
      "kitasan(speed ${1:i} = 0; ${1:i} < ${2:10}; ${1:i}++) {",
      "    $0",
      "}"
    ]
  },
  "Condicional": {
    "prefix": "scarlet",
    "body": [
      "scarlet(${1:condicao}) {",
      "    $0",
      "}"
    ]
  },
  "Enquanto": {
    "prefix": "goldship",
    "body": [
      "goldship(${1:condicao}) {",
      "    $0",
      "}"
    ]
  },
  "Importar modulo": {
    "prefix": "import",
    "body": "import \"${1:std/math}\";"
  },
  "Documentacao": {
    "prefix": "doc",
    "body": "/// ${1:Comportamento, tipos, efeitos, complexidade e erros.}"
  },
  "Imprimir": {
    "prefix": "bakushin",
    "body": "bakushin(${1:valor});"
  },
  "Verificacao": {
    "prefix": "flash",
    "body": "flash(${1:condicao}, \"${2:mensagem}\");"
  },
  "ownership": {
    "prefix": "own",
    "body": [
      "own ${1:speed[]} ${2:valores} = ${3:[1, 2, 3]};"
    ]
  },
  "borrow": {
    "prefix": "borrow",
    "body": [
      "{",
      "    borrow ${1:speed[]} ${2:leitura} = &${3:origem};",
      "    $0",
      "}"
    ]
  },
  "try": {
    "prefix": "treino",
    "body": [
      "treino {",
      "    $1",
      "} tropeco (wit ${2:erro}) {",
      "    bakushin(${2:erro});",
      "} desaquecer {",
      "    $0",
      "}"
    ]
  },
  "interface": {
    "prefix": "estilo",
    "body": [
      "estilo ${1:Corredor} {",
      "    speed ritmo();",
      "}"
    ]
  },
