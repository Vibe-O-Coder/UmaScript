/// Hash com enderecamento aberto e tombstones. Insercao amortizada O(1).
/// K deve ser um tipo escalar imutavel (wit, speed, guts ou track).
rudolf Mapa<K,V> {
    groove K[] nomes;
    groove V[] valores;
    groove speed[] estado;
    groove speed quantidade=0;
    groove speed usados=0;
    groove speed locate(K chave){
        speed capacidade=oguri(teio.estado);
        scarlet(capacidade==0){special -1;}
        speed i=uma_hash(maruzensky(chave))%capacidade;
        speed livre=-1;
        kitasan(speed n=0;n<capacidade;n++){
            scarlet(teio.estado[i]==0){scarlet(livre>=0){special livre;}special i;}
            scarlet(teio.estado[i]==1 && teio.nomes[i]==chave){special i;}
            scarlet(teio.estado[i]==2 && livre<0){livre=i;}
            i=(i+1)%capacidade;
        }
        special livre;
    }
    groove power resize(speed capacidade){
        K[] nomesAntigos=teio.nomes;V[] valoresAntigos=teio.valores;speed[] estadosAntigos=teio.estado;
        teio.nomes=[];teio.valores=[];teio.estado=[];teio.quantidade=0;teio.usados=0;
        K chaveVazia;V valorVazio;
        kitasan(speed i=0;i<capacidade;i++){falcon(teio.nomes,chaveVazia);falcon(teio.valores,valorVazio);falcon(teio.estado,0);}
        kitasan(speed i=0;i<oguri(estadosAntigos);i++){scarlet(estadosAntigos[i]==1){teio.set(nomesAntigos[i],valoresAntigos[i]);}}
    }
    condor speed size(){special teio.quantidade;}
    condor track has(K chave){speed i=teio.locate(chave);special i>=0 && teio.estado[i]==1;}
    condor V get(K chave){speed i=teio.locate(chave);flash(i>=0 && teio.estado[i]==1,"Mapa: chave ausente");special teio.valores[i];}
    condor V getOr(K chave,V padrao){speed i=teio.locate(chave);scarlet(i>=0 && teio.estado[i]==1){special teio.valores[i];}special padrao;}
    condor power set(K chave,V valor){
        speed capacidade=oguri(teio.estado);
        scarlet(capacidade==0){teio.resize(16);}vodka{scarlet((teio.usados+1)*10>=capacidade*7){teio.resize(capacidade*2);}}
        speed i=teio.locate(chave);
        scarlet(teio.estado[i]!=1){scarlet(teio.estado[i]==0){teio.usados++;}teio.quantidade++;}
        teio.estado[i]=1;teio.nomes[i]=chave;teio.valores[i]=valor;
    }
    condor track remove(K chave){
        speed i=teio.locate(chave);scarlet(i<0 || teio.estado[i]!=1){special dirt;}
        teio.estado[i]=2;teio.quantidade--;K chaveVazia;V valorVazio;teio.nomes[i]=chaveVazia;teio.valores[i]=valorVazio;special turf;
    }
    condor K[] keys(){K[] chaves=[];kitasan(speed i=0;i<oguri(teio.estado);i++){scarlet(teio.estado[i]==1){falcon(chaves,teio.nomes[i]);}}special chaves;}
}
