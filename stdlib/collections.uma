    kitasan(speed i = 0; i < oguri(valores); i++) { falcon(resultado, valores[i]); }
    special resultado;
}
// Heapsort: O(n log n) no pior caso, O(1) memoria auxiliar.
power umaSiftDown(speed[] a, speed raiz, speed tamanho) {
    goldship(raiz < tamanho / 2) {
        speed filho = raiz * 2 + 1;
        scarlet(filho + 1 < tamanho && a[filho] < a[filho + 1]) { filho++; }
        scarlet(a[raiz] >= a[filho]) { special; }
        speed temp = a[raiz]; a[raiz] = a[filho]; a[filho] = temp; raiz = filho;
    }
}
/// Ordena inteiros in-place em ordem crescente por heapsort. O(n log n), instavel.
power sort(speed[] valores) {
    ordenar(valores);
}
/// Busca binaria em array previamente ordenado. Indice ou -1; O(log n).
speed binarySearch(speed[] valores, speed valor) {
    speed baixo = 0; speed alto = oguri(valores);
    goldship(baixo < alto) {
        speed meio = baixo + (alto - baixo) / 2;
        scarlet(valores[meio] < valor) { baixo = meio + 1; } vodka { alto = meio; }
    }
    scarlet(baixo < oguri(valores) && valores[baixo] == valor) { special baixo; }
    special -1;
}
