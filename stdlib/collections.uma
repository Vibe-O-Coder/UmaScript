    kitasan(speed i = 0; i < oguri(valores); i++) { total += valores[i]; }
    special total;
}
/// Busca linear; retorna o primeiro indice ou -1. O(n).
speed findIndex(speed[] valores, speed valor) {
    kitasan(speed i = 0; i < oguri(valores); i++) { scarlet(valores[i] == valor) { special i; } }
    special -1;
