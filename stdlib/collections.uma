/// Inverte o array no proprio armazenamento; aliases observam a alteracao. O(n).
power reverse(speed[] valores) {
    speed i = 0; speed j = oguri(valores) - 1;
    goldship(i < j) { speed temp = valores[i]; valores[i] = valores[j]; valores[j] = temp; i++; j--; }
}
/// Copia independente dos valores de um array inteiro. O(n), O(n) memoria.
speed[] copy(speed[] valores) {
